# Copy to .env and fill locally. Never commit .env.
# The Inference.sh connection uses INFERENCE_API_KEY below, not JEV_API_KEY.
# Its app IDs come from model YAML. Generic hosted variables remain available.
# Notebooks report variable availability only; never print values in cells.
# Credentials alone do not enable calls: a provider adapter and both paid-call
# permissions (workflow YAML and notebook cell) are also required.

# Hosted inference
JEV_API_BASE_URL=
JEV_API_KEY=
JEV_9B_HOSTED_MODEL_ID=
JEV_27B_HOSTED_MODEL_ID=


INFERENCE_API_KEY=

# Optional override for real evaluation data.
# Empty means use data/private/states from the evaluation configuration.
JEV_DATA_DIR=

# Optional override for local model storage.
# Empty means use models from the local backend configuration.
JEV_MODEL_DIR=
